{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
